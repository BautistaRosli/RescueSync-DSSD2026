# SMTP opcional; SMTP_PASSWORD es la contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
SMTP_PASSWORD=

# Entorno local.
APP_ENV=development

# JWT local: configurar un secreto propio de al menos 32 bytes.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# API-Cloud: desde Docker usar http://host.docker.internal:8002.
CLOUD_API_URL=http://127.0.0.1:8002
# Cuenta de aplicación aprovisionada en API-Cloud.
CLOUD_APP_USUARIO=
CLOUD_APP_PASSWORD=

# Precarga sólo en development: CUIT verificado de cada organización, sin valores por defecto.
# Sólo CUIT solicita el alta nacional. CUIT + ONG_ID verifica la ficha existente por GET.
# La ficha debe coincidir exactamente en CUIT, nombre y email local, sin espacios externos.
# Ante CUIT ya registrado (409), completar ONG_ID con el ID confirmado en Cloud.
# Sin CUIT o con Cloud indisponible se conserva la demo local y se reintenta al arrancar.
# Las vinculaciones guardadas se conservan: no se reasignan ni repiten solicitudes HTTP.
CLOUD_ONU_CUIT=
CLOUD_ONU_ONG_ID=
CLOUD_UNICEF_CUIT=
CLOUD_UNICEF_ONG_ID=

# Servicio de prioridad en Kubernetes (NodePort). En Docker Compose usar host.docker.internal.
PRIORIDAD_SERVICE_URL=http://localhost:30080
