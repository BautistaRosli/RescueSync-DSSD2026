# SMTP opcional; SMTP_PASSWORD es la contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
SMTP_PASSWORD=

# Entorno local.
APP_ENV=development

# JWT local: configurar un secreto propio de al menos 32 bytes.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# API-Cloud: desde Docker usar http://host.docker.internal:8002.
CLOUD_API_URL=http://127.0.0.1:8002
# Cuenta de aplicación aprovisionada en API-Cloud.
CLOUD_APP_USUARIO=
CLOUD_APP_PASSWORD=
