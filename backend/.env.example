# Plantilla de secretos del backend. Copiala a .env y completala.
#
#   cp backend/.env.example backend/.env
#
# Configuracion SMTP (Gmail) completa. El servicio `backend` de
# docker-compose.yml carga este archivo con `env_file`, asi que las cinco
# variables se configuran aca y no en el compose.
#
# SMTP_PASSWORD contiene la app password de Gmail.
# Cuenta de Google > Seguridad > Verificacion en 2 pasos > Contrasenas de aplicacion
# (requiere 2FA activado, 16 caracteres)

SMTP_HOST=
SMTP_PORT=
SMTP_USER=@gmail.com
SMTP_FROM=rescuesync@gmail.com
SMTP_PASSWORD=

# Sólo development habilita los diagnósticos de Bonita (requieren coordinador).
APP_ENV=development
# Obligatorio: el mismo secreto de al menos 32 bytes que usa Cloud.
JWT_SECRET=
JWT_ISSUER=rescuesync-cloud
JWT_AUDIENCE=rescuesync-backend
# Backend local. En Docker usar http://host.docker.internal:8002.
CLOUD_API_URL=http://127.0.0.1:8002