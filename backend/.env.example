# Plantilla de secretos del backend. Copiala a .env y completala.
#
#   cp backend/.env.example backend/.env
#
# El host, puerto, usuario y remitente van en docker-compose.yml.
# Acá solo va la password.

# App password de Gmail (16 caracteres, requiere 2FA activado).
# Cuenta de Google > Seguridad > Verificacion en 2 pasos > Contrasenas de aplicacion
SMTP_PASSWORD=
